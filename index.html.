    <div class="cardimg">${p.image_url?`<img alt="" src="${esc(p.image_url)}" onload="this.classList.add('ok')">`:p.card_name?`<img alt="" data-card="${esc(p.card_name)}">`:''}</div>
    <div class="grow"><b>${esc(p.name)}</b><span class="muted small">${gs(p.price_pyg)} c/u</span></div>
    <div style="text-align:right"><div class="stepper"><button ${attr({act:'cartDec',id:p.id})} aria-label="Quitar uno">${ic('minus')}</button><b>${qty}</b><button ${attr({act:'cartInc',id:p.id})} aria-label="Sumar uno">${ic('plus')}</button></div></div></div>`).join('')
   +`<div class="total"><span>Total</span><span>${gs(cartTotal())}</span></div>
     <button class="btn primary block" style="margin-top:16px" data-act="checkout">Continuar con el pedido</button>`;
