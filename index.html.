  setSheet(`<form data-form="checkout">
    <div class="panel" style="margin-bottom:16px">${lines.map(l=>`<div style="display:flex;justify-content:space-between;gap:10px"><span>${l.qty}× ${esc(l.p.name)}</span><b>${gs(l.p.price_pyg*l.qty)}</b></div>`).join('')}
      <div class="total"><span>Total</span><span>${gs(cartTotal())}</span></div></div>
    <label class="field"><span>Nombre y apellido</span><input class="input" name="name" value="${esc(pr.name||'')}" required autocomplete="name"></label>
    <label class="field"><span>Teléfono / WhatsApp</span><input class="input" name="phone" value="${esc(pr.phone||'')}" type="tel" required autocomplete="tel"></label>
    <div class="field"><span>Entrega</span><div class="choice">
      <label><input type="radio" name="delivery" value="retiro" checked><div><b>Retiro</b><small>Sin costo</small></div></label>
      <label><input type="radio" name="delivery" value="envio"><div><b>Envío</b><small>Se coordina</small></div></label></div></div>
    <label class="field" id="addrField" hidden><span>Dirección de envío</span><textarea class="input" name="address" placeholder="Calle, barrio y ciudad. Pegá también el link de Google Maps de tu ubicación." autocomplete="street-address">${esc(pr.address||'')}</textarea><small class="muted">En Google Maps: tocá tu ubicación › Compartir › Copiar link. El costo depende de la distancia.</small></label>
    <div class="field"><span>Pago</span><div class="choice">
      <label><input type="radio" name="payment" value="transferencia" checked><div><b>Transferencia</b><small>Te pasamos los datos</small></div></label>
      <label><input type="radio" name="payment" value="efectivo"><div><b>Efectivo</b><small>Al retirar o recibir</small></div></label></div></div>
    <label class="field"><span>Notas (opcional)</span><textarea class="input" name="notes" placeholder="Horario preferido, dudas…"></textarea></label>
    <p class="err" id="coErr" role="alert"></p>
    <button class="btn primary block" type="submit" id="coBtn">Confirmar pedido</button>
    <p class="muted small" style="margin-top:10px">Al confirmar reservamos tu stock. El pedido queda pendiente hasta que confirmemos tu pago.</p></form>`);
  $$('input[name=delivery]').forEach(r=>r.addEventListener('change',()=>{ $('#addrField').hidden=$('input[name=delivery]:checked').value!=='envio'; }));
}
function setSheetTitle(t){ const h=$('.sheet header h2'); if(h) h.textContent=t; }
async function placeOrder(form){
  const f=new FormData(form), btn=$('#coBtn'), err=$('#coErr'); err.textContent='';
  const delivery=f.get('delivery'), address=(f.get('address')||'').trim();
  if(delivery==='envio'&&!address){ err.textContent='Escribí la dirección de envío.'; return; }
  btn.disabled=true; btn.textContent='Enviando…';
  const items=Object.entries(S.cart).map(([product_id,qty])=>({product_id,qty}));
  const {data,error}=await sb.rpc('place_order',{
    p_items:items,p_customer_name:f.get('name').trim(),p_phone:f.get('phone').trim(),p_delivery:delivery,
    p_address:address||null,p_payment:f.get('payment'),p_notes:(f.get('notes')||'').trim()||null
  });
  if(error){
    err.textContent=error.message.replace(/^.*?:\s*/,'');
    btn.disabled=false; btn.textContent='Confirmar pedido';
    await loadProducts(); return;
  }
  store.set('pc_profile',{name:f.get('name').trim(),phone:f.get('phone').trim(),address});
  const payment=f.get('payment');
  S.cart={}; saveCart(); await loadProducts();
  showOrderDone({reference:data.reference,total:data.total,payment,delivery});
}
function waLink(text,phone){ return `https://wa.me/${phone||STORE_CONFIG.whatsapp}?text=${encodeURIComponent(text)}`; }
function waPhone(p){ let d=String(p).replace(/\D/g,''); if(d.startsWith('0')) d='595'+d.slice(1); return d; }
function payInstructions(o){
  const b=STORE_CONFIG.bank;
  if(o.payment==='transferencia') return `<div class="panel" style="margin:14px 0"><h3 style="margin-bottom:10px">Transferí ${gs(o.total)}</h3>
    <dl class="kv">${[['Banco',b.banco],['Titular',b.titular],['Alias / cuenta',b.cuenta],['Documento',b.documento]].filter(r=>r[1]).map(r=>`<dt>${r[0]}</dt><dd>${esc(r[1])}</dd>`).join('')}<dt>Concepto</dt><dd>${esc(o.reference)}</dd></dl>
    <p class="small muted" style="margin-top:10px">Poné el código <b>${esc(o.reference)}</b> como concepto y mandanos el comprobante por WhatsApp.</p></div>`;
  return `<div class="notice" style="margin:14px 0">Pagás ${gs(o.total)} en efectivo ${o.delivery==='retiro'?'al retirar':'al recibir'}. Te escribimos por WhatsApp para coordinar.</div>`;
}
function showOrderDone(o){
  setSheetTitle('¡Pedido recibido!');
  setSheet(`<p>Guardamos tu pedido. Tu código es:</p><div class="refcode">${esc(o.reference)}</div>
    ${payInstructions(o)}
    <p class="small muted">${o.delivery==='retiro'?esc(STORE_CONFIG.pickup):esc(STORE_CONFIG.shippingNote)}</p>
    <a class="btn sun block" style="margin-top:16px" target="_blank" rel="noopener" href="${waLink(`Hola! Hice el pedido ${o.reference} por ${gs(o.total)}.${o.payment==='transferencia'?' Te paso el comprobante.':''}`)}">Avisar por WhatsApp</a>
    <button class="btn block" style="margin-top:10px" data-act="goOrders">Ver mis pedidos</button>`);
}
async function renderMyOrders(){
  const body=$('#shopBody'); body.innerHTML='<p class="muted">Cargando…</p>';
  const {data,error}=await sb.from('orders').select('*, order_items(*)').eq('user_id',S.user.id).order('created_at',{ascending:false});
  if(S.view!=='shop'||S.shopTab!=='orders') return;
  if(error){ body.innerHTML=empty('No se pudieron cargar tus pedidos',esc(error.message)); return; }
  S.orders=data||[];
  body.innerHTML=S.orders.length?S.orders.map(o=>orderHtml(o,false)).join(''):empty('Todavía no hiciste pedidos','Cuando compres algo, lo vas a ver acá con su estado.',`<button class="btn primary" data-act="shopTab" data-v="catalog">Ver el catálogo</button>`);
}
const STATUS=['pendiente','pagado','enviado','entregado','cancelado'];
function orderHtml(o,admin){
  const items=(o.order_items||[]).map(i=>`<li><span>${i.quantity}× ${esc(i.name)}</span><span>${gs(i.unit_price_pyg*i.quantity)}</span></li>`).join('');
  const pend=o.status==='pendiente';
  return `<div class="order"><div class="top2"><div><b style="font:800 18px var(--display)">${esc(o.reference)}</b><div class="muted small">${fdate(o.created_at)}</div></div><span class="pill ${o.status}">${o.status}</span></div>
    ${admin?`<p><b>${esc(o.customer_name)}</b> · <a href="${waLink('Hola '+o.customer_name+', te escribo por tu pedido '+o.reference+'.',waPhone(o.phone))}" target="_blank" rel="noopener">${esc(o.phone)}</a></p>`:''}
    <ul>${items}</ul><div style="display:flex;justify-content:space-between;font-weight:800"><span>Total</span><span>${gs(o.total_pyg)}</span></div>
    <p class="muted small" style="margin-top:8px">${o.delivery==='retiro'?'Retiro':'Envío a '+esc(o.address||'')} · ${o.payment_method==='transferencia'?'Transferencia':'Efectivo'}${o.notes?' · “'+esc(o.notes)+'”':''}</p>
    ${admin?`<label class="field" style="margin:12px 0 0"><span>Estado</span><select class="input" data-on="orderStatus" data-id="${esc(o.id)}" data-cur="${o.status}">${STATUS.map(s=>`<option ${s===o.status?'selected':''}>${s}</option>`).join('')}</select></label>`
      :(pend&&o.payment_method==='transferencia'?`<a class="btn sun sm" style="margin-top:12px" target="_blank" rel="noopener" href="${waLink(`Hola! Te paso el comprobante del pedido ${o.reference}.`)}">Enviar comprobante</a>`:'')}</div>`;
}

/* ---------- ADMIN ---------- */
function renderAdmin(){
  const root=$('#v-admin');
  if(!S.isAdmin){ root.innerHTML=empty('Solo para administradores','Tu cuenta no tiene permisos para ver esto.',`<button class="btn" data-act="go" data-view="shop">Volver a la tienda</button>`); return; }
  root.innerHTML=`<div class="pagehead"><div><h1>Administrar tienda</h1></div><button class="btn sm" data-act="go" data-view="shop">Ver como cliente</button></div>
    <div style="margin-bottom:16px">${seg('adminTab',S.adminTab,[['orders','Pedidos'],['products','Productos']])}</div><div id="adminBody"></div>`;
  if(S.adminTab==='orders') renderAdminOrders(); else renderAdminProducts();
}
async function renderAdminOrders(){
  const body=$('#adminBody'); body.innerHTML='<p class="muted">Cargando…</p>';
  const {data,error}=await sb.from('orders').select('*, order_items(*)').order('created_at',{ascending:false});
  if(error){ body.innerHTML=empty('No se pudieron cargar los pedidos',esc(error.message)); return; }
  S.adminOrders=data||[];
  drawAdminOrders();
}
function drawAdminOrders(){
  const body=$('#adminBody'); if(!body||S.adminTab!=='orders') return;
  const f=S.adminOrderFilter, list=S.adminOrders.filter(o=>f==='todos'||o.status===f);
  const cnt=s=>S.adminOrders.filter(o=>o.status===s).length;
  body.innerHTML=`<div class="chips" style="margin-bottom:16px">${['pendiente','pagado','enviado','entregado','cancelado','todos'].map(s=>`<button class="chip" aria-pressed="${f===s}" data-act="adminFilter" data-v="${s}">${s==='todos'?'Todos':s[0].toUpperCase()+s.slice(1)}${s!=='todos'?` (${cnt(s)})`:''}</button>`).join('')}</div>
    ${list.length?list.map(o=>orderHtml(o,true)).join(''):empty('No hay pedidos acá','Cuando alguien compre, aparece en esta lista.')}`;
}
async function changeOrderStatus(sel){
  const id=sel.dataset.id,next=sel.value,cur=sel.dataset.cur;
  if(next==='cancelado'&&!confirm('Al cancelar se devuelve el stock y el pedido no se puede reactivar. ¿Cancelar?')){ sel.value=cur; return; }
  const {error}=await sb.rpc('set_order_status',{p_order:id,p_status:next});
  if(error){ toast(error.message.replace(/^.*?:\s*/,''),1); sel.value=cur; return; }
  toast('Pedido '+next); await loadProducts(); renderAdminOrders();
}
function renderAdminProducts(){
  const body=$('#adminBody');
  body.innerHTML=`<button class="btn primary" data-act="editProduct" style="margin-bottom:16px">${ic('plus')}Nuevo producto</button>
   ${S.shopError?empty('Falta correr el SQL de la tienda',esc(S.shopError)):''}
   ${S.products.length?`<div class="panel">${S.products.map(p=>`<div class="rowline">
      <div class="cardimg">${p.image_url?`<img alt="" src="${esc(p.image_url)}" onload="this.classList.add('ok')">`:p.card_name?`<img alt="" data-card="${esc(p.card_name)}">`:''}</div>
      <div class="grow"><b>${esc(p.name)}</b><span class="muted small">${gs(p.price_pyg)} · ${p.kind==='deck'?'Deck':p.kind==='single'?'Carta':'Otro'} ${p.active?'':'· <b>oculto</b>'}</span></div>
      <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
        <div class="stepper"><button ${attr({act:'stockDec',id:p.id})} aria-label="Bajar stock">${ic('minus')}</button><b title="Stock">${p.stock}</b><button ${attr({act:'stockInc',id:p.id})} aria-label="Subir stock">${ic('plus')}</button></div>
        <div><button class="btn sm" ${attr({act:'editProduct',id:p.id})}>Editar</button></div></div></div>`).join('')}</div>`
     :(S.shopError?'':empty('Todavía no cargaste productos','Empezá por tu primer deck o carta suelta.'))}`;
  hydrate(body);
}
async function changeStock(id,d){
  const p=S.products.find(x=>x.id===id); if(!p) return;
  const stock=Math.max(0,p.stock+d);
  const {error}=await sb.from('products').update({stock}).eq('id',id);
  if(error) return toast(error.message,1);
  p.stock=stock; renderAdminProducts();
}
function editProduct(id){
  const p=S.products.find(x=>x.id===id)||{kind:'single',active:true,stock:1};
  openSheet(id?'Editar producto':'Nuevo producto',`<form data-form="product" data-id="${esc(id||'')}">
    <label class="field"><span>Tipo</span><select class="input" name="kind">${[['single','Carta suelta'],['deck','Deck armado'],['otro','Otro']].map(([v,l])=>`<option value="${v}" ${p.kind===v?'selected':''}>${l}</option>`).join('')}</select></label>
    <label class="field"><span>Nombre</span><input class="input" name="name" value="${esc(p.name||'')}" required maxlength="120"></label>
    <label class="field"><span>Descripción (opcional)</span><textarea class="input" name="description">${esc(p.description||'')}</textarea></label>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <label class="field"><span>Precio (Gs.)</span><input class="input" name="price" inputmode="numeric" value="${p.price_pyg??''}" required></label>
      <label class="field"><span>Stock</span><input class="input" name="stock" inputmode="numeric" value="${p.stock??0}" required></label></div>
    <label class="field"><span>Nombre de la carta (para traer la imagen)</span><input class="input" name="card_name" value="${esc(p.card_name||'')}" placeholder="Ej: Charizard ex"></label>
    <label class="field"><span>Link de imagen propia (opcional)</span><input class="input" name="image_url" value="${esc(p.image_url||'')}" placeholder="https://…"></label>
    <label class="field"><span>Estado de la carta (opcional)</span><input class="input" name="condition" value="${esc(p.condition||'')}" placeholder="NM, LP, MP…" maxlength="12"></label>
    <label style="display:flex;gap:10px;align-items:center;margin-bottom:16px"><input type="checkbox" name="active" ${p.active?'checked':''} style="width:20px;height:20px;accent-color:var(--brand)"> Visible en la tienda</label>
    <p class="err" id="pfErr" role="alert"></p>
    <button class="btn primary block" type="submit">Guardar</button>
    ${id?`<button class="btn danger block" type="button" style="margin-top:10px" data-act="delProduct" data-id="${esc(id)}">Eliminar producto</button>`:''}</form>`);
}
async function saveProduct(form){
  const f=new FormData(form), id=form.dataset.id, err=$('#pfErr');
  const price=parseInt(String(f.get('price')).replace(/\D/g,''),10), stock=parseInt(String(f.get('stock')).replace(/\D/g,''),10);
  if(!(price>=0)||!(stock>=0)){ err.textContent='Revisá el precio y el stock: tienen que ser números.'; return; }
  const row={kind:f.get('kind'),name:f.get('name').trim(),description:(f.get('description')||'').trim()||null,price_pyg:price,stock,
    card_name:(f.get('card_name')||'').trim()||null,image_url:(f.get('image_url')||'').trim()||null,condition:(f.get('condition')||'').trim()||null,active:f.get('active')==='on'};
  const q=id?sb.from('products').update(row).eq('id',id):sb.from('products').insert(row);
  const {error}=await q;
  if(error){ err.textContent=error.message; return; }
  closeSheet(); toast(id?'Producto actualizado':'Producto creado');
  await loadProducts(); if(S.view==='admin') renderAdminProducts();
}
async function delProduct(id){
  if(!confirm('¿Eliminar este producto? Los pedidos anteriores se conservan.')) return;
  const {error}=await sb.from('products').delete().eq('id',id);
  if(error) return toast(error.message,1);
  closeSheet(); toast('Producto eliminado'); await loadProducts(); renderAdminProducts();
}

/* ---------- cuenta ---------- */
function openMenu(){
  openSheet('Mi cuenta',`<p class="muted" style="margin-bottom:16px;overflow-wrap:anywhere">${esc(S.user.email)}${S.isAdmin?' · administrador':''}</p>
   <div class="stack"><button class="btn block" data-act="goOrders">Mis pedidos</button>
   ${S.isAdmin?`<button class="btn block" data-act="goAdmin">Administrar tienda</button>`:''}
   <button class="btn block danger" data-act="signOut">Cerrar sesión</button></div>`,{focus:false});
}

/* ---------- eventos ---------- */
const actions={
  go:d=>go(d.view), goShop:()=>{closeSheet();S.shopTab='catalog';go('shop')}, goMeta:()=>{S.deckTab='meta';go('decks')},
  goOrders:()=>{closeSheet();S.shopTab='orders';go('shop')}, goAdmin:()=>{closeSheet();go('admin')},
  authMode:d=>setAuthMode(d.v), signOut, openMenu, openCart, closeSheet,
  openCardSearch:d=>openCardSearch(d.v), cardAdd:d=>cardAdd(d.v,d.name),
  collTab:d=>{S.collTab=d.v;S.collQuery='';renderCollection()},
  collInc:d=>setCollQty(d.name,(S.collection[d.name]||0)+1), collDec:d=>setCollQty(d.name,(S.collection[d.name]||0)-1),
  collDel:d=>{ if(confirm('¿Quitar '+d.name+' de tu colección?')) setCollQty(d.name,0) },
  wishGot:d=>gotWish(d.name), wishDel:d=>addWishQty(d.name,0),
  deckTab:d=>{S.deckTab=d.v;renderDecks()}, newDeckFrom:d=>{closeSheet();newDeckFrom(d.name)}, newBlankDeck,
  openDeck:d=>openDeck(d.id), delDeck:d=>delDeck(d.id),
  builderMode:d=>{S.builderMode=d.v;renderBuilder()},
  deckSug:d=>changeDeckCard(d.name,+d.d,+d.max), deckFree:d=>changeFreeCard(d.name,+d.d),
  refreshMeta,
  shopTab:d=>{S.shopTab=d.v;renderShop()}, shopFilter:d=>{S.shopFilter=d.v;renderShop()},
  openProduct:d=>openProduct(d.id), addToCart:d=>addToCart(d.id,d.close),
  cartInc:d=>changeCart(d.id,1), cartDec:d=>changeCart(d.id,-1), checkout,
  adminTab:d=>{S.adminTab=d.v;renderAdmin()}, adminFilter:d=>{S.adminOrderFilter=d.v;drawAdminOrders()},
  editProduct:d=>editProduct(d.id), stockInc:d=>changeStock(d.id,1), stockDec:d=>changeStock(d.id,-1), delProduct:d=>delProduct(d.id)
};
document.addEventListener('click',e=>{
  if(e.target.id==='layer'){ closeSheet(); return; }
  const el=e.target.closest('[data-act]'); if(!el) return;
  const fn=actions[el.dataset.act]; if(fn) fn(el.dataset,el,e);
});
const inputs={
  homeSearch:debounce(onHomeSearch), collQuery:el=>{S.collQuery=el.value;renderCollectionGrid()},
  shopQuery:el=>{S.shopQuery=el.value;renderShopGrid()}, sheetSearch:el=>onSheetSearch(el), orderStatus:changeOrderStatus
};
document.addEventListener('input',e=>{ const el=e.target.closest('[data-on]'); if(el&&el.tagName!=='SELECT') inputs[el.dataset.on]?.(el); });
document.addEventListener('change',e=>{ const el=e.target.closest('select[data-on]'); if(el) inputs[el.dataset.on]?.(el); });
document.addEventListener('submit',e=>{
  const f=e.target; if(f.id==='authForm'){ submitAuth(e); return; }
  const k=f.dataset.form; if(!k||k==='ask') return;
  e.preventDefault();
  if(k==='checkout') placeOrder(f); else if(k==='product') saveProduct(f);
});
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&!$('#layer').hidden) closeSheet(); });
boot();
</script>
</body>
</html>
