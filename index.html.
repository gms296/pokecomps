/* ---------- API de cartas (imagen + precio real) ---------- */
const infoCache={};
const printHints={};   // nombre -> {set,num}: expansión y número de la impresión exacta (vienen de las listas reales)
const normName=s=>String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]/g,'');
const isStd=c=>!!(c.legalities&&c.legalities.standard==='Legal');
const priceOf=c=>{
  if(!(c.tcgplayer&&c.tcgplayer.prices)) return null;
  const vs=Object.values(c.tcgplayer.prices).filter(Boolean), v=vs.find(v=>v.market)||vs[0];
  return v?(v.market||v.mid||v.low||null):null;
};
/* Pedidos a la API: de a pocos a la vez, con límite de tiempo y reintentos (la API a veces tarda o falla un rato) */
let apiActive=0; const apiWaiting=[];
const apiSlot=()=>new Promise(res=>{ const go=()=>{apiActive++;res()}; apiActive<4?go():apiWaiting.push(go); });
const apiFree=()=>{ apiActive--; const n=apiWaiting.shift(); if(n) n(); };
async function apiGet(q,tries=3){
  await apiSlot();
  try{
    for(let i=0;i<tries;i++){
      const ctl=new AbortController(), t=setTimeout(()=>ctl.abort(),12000);
      try{
        const r=await fetch(`https://api.pokemontcg.io/v2/cards?q=${encodeURIComponent(q)}&pageSize=40&orderBy=-set.releaseDate`,{headers:pokemonTcgHeaders,signal:ctl.signal});
        clearTimeout(t);
        if(r.ok) return (await r.json()).data||[];
        if(r.status!==429&&r.status<500) return [];
      }catch(e){ clearTimeout(t); }
      if(i<tries-1) await new Promise(r=>setTimeout(r,700*(i+1)*(i+1)));
    }
  }finally{ apiFree(); }
  throw new Error('api');
}
/* Caché en el dispositivo: las cartas que ya se vieron no se vuelven a pedir durante 24 h */
const CI_KEY='pc_ci_v1', CI_TTL=24*3600*1000;
let ciDisk=store.get(CI_KEY,{});
const ciSave=debounce(()=>{
  const ks=Object.keys(ciDisk); if(ks.length>700) ks.sort((a,b)=>ciDisk[a].t-ciDisk[b].t).slice(0,ks.length-600).forEach(k=>delete ciDisk[k]);
  store.set(CI_KEY,ciDisk);
},1500);
function cardInfo(name){
  const h=printHints[name], key=h?`${name}|${h.set}|${h.num}`:name;
  if(infoCache[key]) return infoCache[key];
  const d=ciDisk[key];
  if(d&&Date.now()-d.t<CI_TTL){ return infoCache[key]=Promise.resolve(d.v); }
  const p=(async()=>{
    const info={image:null,price:null,exact:false}; let failed=false;
    try{
      let c=null;
      // 1) Doble chequeo: expansión + número de carta, y el nombre tiene que coincidir.
      if(h){
        const hit=(await apiGet(`set.ptcgoCode:${h.set} number:${h.num}`)).find(x=>normName(x.name)===normName(name));
        if(hit){ c=hit; info.exact=true; }
      }
      // 2) Si no hay datos de expansión: solo cartas con EXACTAMENTE ese nombre (no "Larry's Dunsparce" para "Dunsparce"),
      //    prefiriendo la impresión más nueva que sea legal en Standard.
      if(!c){
        const q=basicEnergies.includes(name)?`name:"${name}" supertype:Energy subtypes:Basic`:`name:"${name}"`;
        const pool=(await apiGet(q)).filter(x=>normName(x.name)===normName(name));
        if(pool.length){ c=pool.find(isStd)||pool[0]; info.legalStandard=pool.some(isStd); }
      }
      if(c){ info.image=c.images?c.images.small:null; info.price=priceOf(c); }
    }catch(e){ failed=true; }
    if(info.price==null) info.price=cards[name]||0;
    if(failed){ delete infoCache[key]; }                       // un error de red NO se guarda: se reintenta la próxima vez
    else if(info.image){ ciDisk[key]={t:Date.now(),v:info}; ciSave(); }
    return info;
  })();
  infoCache[key]=p; return p;
}
async function searchCards(query){
  try{
    const clean=query.replace(/["\\]/g,'');
    const data=await apiGet(`name:${clean}*`);
    const seen=new Set(),out=[];
    for(const c of data){
      if(seen.has(c.name)) continue; seen.add(c.name);
      out.push({name:c.name,image:c.images?c.images.small:null,set:c.set?c.set.name:'',legal:isStd(c)});
      if(out.length>=24) break;
    }
    return out;
  }catch(e){return null}   // null = la API no respondió (distinto de "sin resultados")
}
/* Completa imágenes y precios marcados con data-card / data-price dentro de un contenedor */
function hydrate(root=document){
  $$('img[data-card]',root).forEach(img=>{
    if(img.dataset.done) return; img.dataset.done=1;
    const show=()=>{ img.classList.add('ok'); img.parentElement?.classList.add('has'); };
    img.addEventListener('load',show);
    img.addEventListener('error',()=>{
      img.classList.remove('ok'); img.parentElement?.classList.remove('has');
      if(!img.dataset.retried&&img.src){ img.dataset.retried=1; const s=img.src; setTimeout(()=>{ img.src=s+(s.includes('?')?'&':'?')+'r=1'; },1500); }
    });
    cardInfo(img.dataset.card).then(i=>{ if(i.image) img.src=i.image; });
  });
  $$('[data-price]',root).forEach(el=>{
    const m=+el.dataset.mult||1;
    cardInfo(el.dataset.price).then(i=>{ el.textContent=usd(i.price*m); });
  });
}
