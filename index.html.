        ${can?`<div style="grid-column:1/-1;margin-top:6px"><button class="btn sm" ${attr({act:'newDeckFrom',name:d.name})}>Armar este deck</button></div>`:''}</div>`}).join('')||metaRowsHtml()}</div>
     <div class="section"><div class="head"><h2>Cuánto cuesta armarlos</h2></div><div class="panel" id="costBox"></div></div>`;
