       ${p?`<div><button class="btn sm sun" style="margin-top:6px" ${attr({act:'addToCart',id:p.id})}>En tienda · ${gs(p.price_pyg)}</button></div>`:''}</div>
       <div class="stepper"><button ${attr({act:'deckSug',name:n,d:-1,max:t})} aria-label="Quitar ${esc(n)}">${ic('minus')}</button><b>${cur}/${t}</b><button ${attr({act:'deckSug',name:n,d:1,max:t})} aria-label="Sumar ${esc(n)}">${ic('plus')}</button></div></div>`;
