   <p class="muted small" id="missCost" style="margin-bottom:6px"></p>
   ${ref.map(([n,t])=>{
     const own=S.collection[n]||0, cur=S.deckCards[n]||0, miss=Math.max(0,t-own), p=miss>0?productForCard(n):null;
