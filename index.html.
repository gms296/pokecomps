      const list=refDecks[name],target=list.reduce((s,[,t])=>s+t,0),have=list.reduce((s,[n,t])=>s+Math.min(S.collection[n]||0,t),0);
      return `<div class="rowline"><div class="grow"><b>${esc(name)}</b><span class="muted small">Ya tenés el ${Math.round(100*have/target)}%</span></div><b data-cost="${esc(name)}">…</b></div>`;
    }).join('');
    Object.keys(refDecks).forEach(name=>Promise.all(refDecks[name].map(([n,t])=>cardInfo(n).then(i=>i.price*t))).then(v=>{
