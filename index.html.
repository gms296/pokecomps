      <button class="iconbtn" data-act="openCart" aria-label="Abrir carrito"><span id="icCart"></span><span class="badge" id="cartBadge" hidden>0</span></button>
      <button class="iconbtn" data-act="openMenu" aria-label="Mi cuenta"><span id="icUser"></span></button>
    </div>
  </header>
  <main>
    <section class="view" id="v-home"></section>
    <section class="view" id="v-collection"></section>
    <section class="view" id="v-decks"></section>
    <section class="view" id="v-shop"></section>
    <section class="view" id="v-admin"></section>
  </main>
</div>

<div id="layer" hidden></div>
<div id="toasts" aria-live="polite"></div>

