<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#4A3FDB">
<title>PokeComps</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F1F2F9; --surface:#fff; --soft:#E9EAF5; --ink:#15132B; --muted:#6A6885; --line:#DFE0EE;
  --brand:#4A3FDB; --on-brand:#fff; --sun:#FFD23F; --on-sun:#15132B;
  --ok:#14804F; --ok-bg:#DDF4E8; --bad:#C92F46; --bad-bg:#FCE3E7; --warn-bg:#FFF1C2;
  --display:"Bricolage Grotesque",system-ui,sans-serif; --body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
  --safe-b:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0F0E1C; --surface:#1A1930; --soft:#262543; --ink:#F2F1FF; --muted:#A3A1C4; --line:#2C2B4A;
  --brand:#9A92FF; --on-brand:#0F0E1C; --ok:#58D6A0; --ok-bg:#12352A; --bad:#FF7A8D; --bad-bg:#40202A; --warn-bg:#3D3416;
}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:500 15px/1.45 var(--body);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--display);margin:0;letter-spacing:-.02em;line-height:1.1}
h1{font-size:30px;font-weight:800}h2{font-size:21px;font-weight:800}h3{font-size:16px;font-weight:600;letter-spacing:-.01em}
p{margin:0}.muted{color:var(--muted)}.small{font-size:13px}
button{font:inherit;color:inherit;cursor:pointer}
input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
[hidden]{display:none!important}
svg.ic{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* botones */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);font-weight:700;white-space:nowrap}
a.btn{text-decoration:none}
.btn:active{transform:scale(.97)}
.btn.primary{background:var(--brand);border-color:var(--brand);color:var(--on-brand)}
.btn.sun{background:var(--sun);border-color:var(--sun);color:var(--on-sun)}
.btn.danger{color:var(--bad);border-color:var(--bad)}
.btn.sm{min-height:36px;padding:0 14px;font-size:14px}
.btn.block{width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed}
.iconbtn{width:44px;height:44px;border-radius:50%;border:0;background:transparent;display:grid;place-items:center;position:relative}
.iconbtn:hover{background:var(--soft)}
.badge{position:absolute;top:3px;right:2px;min-width:19px;height:19px;border-radius:10px;background:var(--sun);color:var(--on-sun);font-size:11px;font-weight:800;display:grid;place-items:center;padding:0 5px}

/* formularios */
.field{display:block;margin-bottom:14px}
.field>span{display:block;font-size:13px;font-weight:700;margin-bottom:6px}
.input{width:100%;min-height:46px;padding:10px 14px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface)}
textarea.input{min-height:76px;resize:vertical}
.input:focus{border-color:var(--brand);outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 25%,transparent)}
.search{position:relative}
.search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search .input{padding-left:44px;border-radius:999px;min-height:50px}
.choice{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.choice label{border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;display:flex;gap:10px;align-items:flex-start;cursor:pointer;background:var(--surface)}
.choice input{margin-top:3px;accent-color:var(--brand)}
.choice label:has(input:checked){border-color:var(--brand);background:color-mix(in srgb,var(--brand) 10%,var(--surface))}
.choice b{display:block;font-size:14px}.choice small{color:var(--muted);font-size:12px}

/* segmentado y chips */
.seg{display:inline-flex;background:var(--soft);border-radius:999px;padding:4px;gap:2px;max-width:100%;overflow:auto}
.seg button{border:0;background:transparent;border-radius:999px;min-height:36px;padding:0 16px;font-weight:700;color:var(--muted);white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(20,18,50,.15)}
.chips{display:flex;gap:8px;overflow:auto;padding-bottom:4px;margin:0 -16px;padding-inline:16px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{border:1.5px solid var(--line);background:var(--surface);border-radius:999px;min-height:38px;padding:0 16px;font-weight:600;white-space:nowrap}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.pill{display:inline-block;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:700;background:var(--soft)}
.pill.pendiente{background:var(--warn-bg)}.pill.pagado,.pill.enviado{background:color-mix(in srgb,var(--brand) 18%,var(--surface));color:var(--brand)}
.pill.entregado,.pill.ok{background:var(--ok-bg);color:var(--ok)}.pill.cancelado,.pill.bad{background:var(--bad-bg);color:var(--bad)}

/* estructura */
.top{position:sticky;top:0;z-index:20;background:var(--bg);display:flex;align-items:center;gap:8px;padding:8px 12px 8px 16px;padding-top:calc(8px + env(safe-area-inset-top,0px))}
.logo{font:800 22px/1 var(--display);letter-spacing:-.03em;display:flex;align-items:center;gap:8px;margin-right:auto}
.logo i{width:20px;height:26px;border-radius:5px;background:var(--brand);transform:rotate(-8deg);position:relative;display:block}
.logo i::after{content:"";position:absolute;inset:4px 4px auto auto;width:8px;height:8px;border-radius:50%;background:var(--sun)}
nav#nav{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding-bottom:var(--safe-b)}
nav#nav button{border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 0 8px;font-size:12px;font-weight:700;color:var(--muted)}
nav#nav button[aria-current="page"]{color:var(--brand)}
main{max-width:1080px;margin:0 auto;padding:12px 16px calc(96px + var(--safe-b))}
.view{display:none}.view.on{display:block}
.pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:8px 0 16px;flex-wrap:wrap}
.pagehead p{margin-top:4px}
.stack>*+*{margin-top:16px}
.section{margin-top:28px}
.section>.head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;gap:10px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px}
@media(min-width:880px){
  nav#nav{position:static;display:flex;gap:4px;border:0;background:none;padding:0;order:2}
  nav#nav button{flex-direction:row;gap:8px;font-size:15px;padding:0 16px;min-height:42px;border-radius:999px}
  nav#nav button[aria-current="page"]{background:var(--soft)}
  .top{padding-inline:max(16px,calc((100vw - 1080px)/2 + 16px));background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px)}
  nav#nav{margin-right:auto}
  .logo{margin-right:24px}.top .spacer{flex:1;order:3}.top-actions{order:4}
  main{padding-bottom:48px}
}

/* tarjetas de cartas */
.cardimg{aspect-ratio:5/7;border-radius:10px;background:linear-gradient(145deg,var(--soft),color-mix(in srgb,var(--brand) 14%,var(--soft)));position:relative;overflow:hidden;display:grid;place-items:center;color:var(--muted)}
.cardimg img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .25s}
.cardimg img.ok{opacity:1}
.cardimg .ph{font-size:11px;line-height:1.2;text-align:center;padding:8px;overflow-wrap:anywhere}
.cardimg.has .ph,.rowline .cardimg .ph{display:none}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:14px 12px}
.grid.big{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:20px 14px}
.tile{display:flex;flex-direction:column;gap:6px;min-width:0}
.tile .name{font-weight:700;font-size:14px;line-height:1.2;overflow-wrap:anywhere}
.tile .meta{font-size:12px;color:var(--muted)}
.tile .qty{position:absolute;left:6px;top:6px;background:var(--ink);color:var(--bg);border-radius:999px;font-weight:800;font-size:12px;padding:2px 9px;z-index:2}
.stepper{display:inline-flex;align-items:center;gap:2px;background:var(--soft);border-radius:999px;padding:2px}
.stepper button{width:34px;height:34px;border-radius:50%;border:0;background:var(--surface);display:grid;place-items:center}
.stepper b{min-width:28px;text-align:center}
.rowline{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.rowline:last-child{border-bottom:0}
.rowline .cardimg{width:44px;flex-shrink:0;border-radius:6px}
.rowline .grow{flex:1;min-width:0}
.rowline .grow b{display:block;overflow-wrap:anywhere}

/* tienda */
.product{display:flex;flex-direction:column;gap:8px;text-align:left;background:none;border:0;padding:0;min-width:0}
.product .cardimg{border-radius:12px}
.tag{position:absolute;left:-4px;bottom:10px;background:var(--sun);color:var(--on-sun);font:800 15px/1 var(--display);padding:7px 10px 7px 12px;border-radius:0 8px 8px 0;transform:rotate(-2deg);box-shadow:0 2px 0 rgba(0,0,0,.18);z-index:2}
.product.out .cardimg{filter:grayscale(1);opacity:.6}
.product .name{font-weight:700;line-height:1.2}
.stockline{font-size:12px;font-weight:700}
.stockline.low{color:var(--bad)}.stockline.out{color:var(--muted)}
.hscroll{display:flex;gap:14px;overflow:auto;margin:0 -16px;padding:2px 16px 8px;scroll-snap-type:x proximity;scrollbar-width:none}
.hscroll::-webkit-scrollbar{display:none}
.hscroll>*{flex:0 0 138px;scroll-snap-align:start}

/* inicio */
.hello{padding:10px 0 4px}
.hello h1{margin-bottom:14px}
.statline{display:flex;gap:6px 18px;flex-wrap:wrap;margin-top:14px;color:var(--muted)}
.statline b{color:var(--ink);font-family:var(--display);font-size:19px}
.starter{display:grid;gap:10px;margin-top:22px}
.starter button{display:flex;align-items:center;gap:14px;text-align:left;padding:14px 16px;border-radius:16px;border:1.5px dashed var(--line);background:var(--surface)}
.starter button:hover{border-color:var(--brand)}
.starter .ic{color:var(--brand);width:28px;height:28px}
.starter b{display:block}
.metarow{display:grid;grid-template-columns:1fr auto;gap:2px 10px;padding:12px 0;border-bottom:1px solid var(--line);align-items:center}
.metarow:last-child{border-bottom:0}
.bar{grid-column:1/-1;height:6px;border-radius:3px;background:var(--soft);overflow:hidden}
.bar i{display:block;height:100%;background:var(--brand);border-radius:3px}
.delta.up{color:var(--ok);font-weight:700}.delta.down{color:var(--bad);font-weight:700}

/* capas */
#layer{position:fixed;inset:0;z-index:60;background:rgba(15,14,28,.55);display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--bg);width:100%;max-width:560px;max-height:92dvh;border-radius:24px 24px 0 0;display:flex;flex-direction:column;animation:up .22s ease-out;overflow:hidden}
.sheet.wide{max-width:760px}
.sheet header{display:flex;align-items:center;gap:8px;padding:14px 12px 10px 20px;flex-shrink:0}
.sheet header h2{flex:1}
.sheet .body{padding:4px 20px calc(24px + var(--safe-b));overflow:auto;flex:1}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@media(min-width:880px){#layer{align-items:center}.sheet{border-radius:24px;max-height:88dvh}}
#toasts{position:fixed;left:0;right:0;bottom:calc(84px + var(--safe-b));z-index:80;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;padding:0 16px}
.toast{background:var(--ink);color:var(--bg);padding:11px 18px;border-radius:999px;font-weight:600;font-size:14px;animation:up .2s ease-out;max-width:100%}
.toast.err{background:var(--bad);color:#fff}
@media(min-width:880px){#toasts{bottom:28px}}
.empty{text-align:center;padding:36px 16px;color:var(--muted)}
.empty h3{color:var(--ink);margin-bottom:6px;font-size:18px}
.empty .btn{margin-top:14px}
.notice{padding:12px 14px;border-radius:12px;background:color-mix(in srgb,var(--brand) 10%,var(--surface));font-size:14px}
.notice.warn{background:var(--warn-bg)}
p.err{color:var(--bad);font-weight:600;font-size:14px;margin:8px 0}
.refcode{font:800 34px/1 var(--display);letter-spacing:.04em;text-align:center;padding:18px;border-radius:16px;background:var(--sun);color:var(--on-sun);margin:14px 0;user-select:all}
dl.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:0}
dl.kv dt{color:var(--muted)}dl.kv dd{margin:0;font-weight:700;text-align:right;overflow-wrap:anywhere}
.total{display:flex;justify-content:space-between;font:800 20px var(--display);padding-top:12px;margin-top:6px;border-top:2px solid var(--ink)}
.progress{height:8px;border-radius:4px;background:var(--soft);overflow:hidden;margin:8px 0}
.progress i{display:block;height:100%;background:var(--brand)}
.order{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px}
.order+.order{margin-top:12px}
.order .top2{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px}
.order ul{list-style:none;margin:8px 0;padding:0}.order li{display:flex;justify-content:space-between;gap:10px;padding:3px 0}

/* acceso */
#auth{min-height:100dvh;display:grid;align-content:center;gap:28px;padding:28px 20px;max-width:440px;margin:0 auto}
#auth h1{font-size:40px}
#auth .tabs{margin-bottom:16px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>

<!-- ACCESO -->
<div id="auth" hidden>
  <div>
    <div class="logo" style="margin-bottom:22px"><i></i>PokeComps</div>
    <h1>Tu colección, tus decks y la tienda de cartas en un solo lugar.</h1>
  </div>
  <form id="authForm" class="panel" autocomplete="on">
    <div class="seg tabs" role="group" aria-label="Modo de acceso">
      <button type="button" data-act="authMode" data-v="in" aria-pressed="true">Entrar</button>
      <button type="button" data-act="authMode" data-v="up" aria-pressed="false">Crear cuenta</button>
    </div>
    <label class="field"><span>Email</span><input class="input" id="authEmail" type="email" autocomplete="email" required></label>
    <label class="field"><span>Contraseña</span><input class="input" id="authPass" type="password" autocomplete="current-password" minlength="6" required></label>
    <button class="btn primary block" id="authSubmit" type="submit">Entrar</button>
    <p id="authMsg" class="small muted" style="margin-top:12px" role="status"></p>
  </form>
</div>

<!-- APP -->
<div id="app" hidden>
  <header class="top">
    <div class="logo"><i></i>PokeComps</div>
    <nav id="nav" aria-label="Secciones"></nav>
