/* carrito */
function saveCart(){ store.set('pc_cart',S.cart); updateCartBadge(); }
function pruneCart(){
  let ch=false;
  Object.keys(S.cart).forEach(id=>{
    const p=S.products.find(x=>x.id===id);
    if(!p||!p.active||p.stock<=0){delete S.cart[id];ch=true}
    else if(S.cart[id]>p.stock){S.cart[id]=p.stock;ch=true}
  });
  if(ch) saveCart();
}
function cartLines(){ return Object.entries(S.cart).map(([id,qty])=>({p:S.products.find(x=>x.id===id),qty})).filter(l=>l.p); }
const cartTotal=()=>cartLines().reduce((s,l)=>s+l.p.price_pyg*l.qty,0);
function updateCartBadge(){
  const n=Object.values(S.cart).reduce((a,b)=>a+b,0), b=$('#cartBadge');
  b.hidden=!n; b.textContent=n;
}
function addToCart(id,close){
  const p=S.products.find(x=>x.id===id); if(!p) return;
  const cur=S.cart[id]||0;
  if(cur>=p.stock) return toast('No hay más stock de este producto',1);
  S.cart[id]=cur+1; saveCart(); toast('Agregado al carrito');
  if(close) closeSheet();
}
function changeCart(id,d){
  const p=S.products.find(x=>x.id===id); if(!p) return;
  const q=(S.cart[id]||0)+d;
  if(q<=0) delete S.cart[id]; else if(q>p.stock) return toast('No hay más stock',1); else S.cart[id]=q;
  saveCart(); drawCart();
}
function openCart(){ openSheet('Tu carrito','<div id="cartBox"></div>',{focus:false}); drawCart(); }
function drawCart(){
  const box=$('#cartBox'); if(!box) return;
  const lines=cartLines();
  if(!lines.length){ box.innerHTML=empty('Tu carrito está vacío','Elegí algo de la tienda y volvé acá para finalizar.',`<button class="btn primary" data-act="goShop">Ir a la tienda</button>`); return; }
