/* ---------- Meta ---------- */
async function loadLiveMeta(){
  try{
    const {data:latest}=await sb.from('meta_snapshots').select('captured_at').order('captured_at',{ascending:false}).limit(1).maybeSingle();
    if(!latest){ S.meta={rows:[],updated:null}; return; }
    const {data:cur}=await sb.from('meta_snapshots').select('name,share').eq('captured_at',latest.captured_at).order('share',{ascending:false});
    const {data:prevRow}=await sb.from('meta_snapshots').select('captured_at').lt('captured_at',latest.captured_at).order('captured_at',{ascending:false}).limit(1).maybeSingle();
    const prevMap={};
    if(prevRow){ const {data:prev}=await sb.from('meta_snapshots').select('name,share').eq('captured_at',prevRow.captured_at); (prev||[]).forEach(p=>prevMap[p.name]=p.share); }
    S.meta={updated:latest.captured_at,hasPrev:!!prevRow,rows:(cur||[]).map(d=>({...d,prev:prevMap[d.name]}))};
  }catch(e){ S.meta=null; }
}
function deltaHtml(d){
  if(!S.meta?.hasPrev) return '';
  if(d.prev==null) return '<span class="pill ok">nuevo</span>';
  const x=d.share-d.prev; if(Math.abs(x)<0.1) return '<span class="muted">=</span>';
  return x>0?`<span class="delta up">▲ ${x.toFixed(1)}%</span>`:`<span class="delta down">▼ ${Math.abs(x).toFixed(1)}%</span>`;
}
function metaRowsHtml(limit){
  if(!S.meta) return '<p class="muted">No se pudo leer el meta todavía.</p>';
  if(!S.meta.rows.length) return '<p class="muted">Todavía no hay datos del meta. Entrá a Decks › Meta y tocá Actualizar.</p>';
  const max=Math.max(...S.meta.rows.map(r=>r.share));
  return S.meta.rows.slice(0,limit||99).map(d=>`<div class="metarow"><div><b>${esc(d.name)}</b></div><div><b>${d.share}%</b> ${deltaHtml(d)}</div><div class="bar"><i style="width:${d.share/max*100}%"></i></div></div>`).join('');
}
async function renderMetaTab(){
  const body=$('#deckBody');
  const draw=()=>{
    body.innerHTML=`<div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
      <div><h2>Más jugados en Standard</h2><p class="muted small">${S.meta?.updated?'Actualizado '+fdate(S.meta.updated):'Fuente: Limitless TCG'}</p></div>
